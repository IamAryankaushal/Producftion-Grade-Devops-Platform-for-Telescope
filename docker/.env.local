# ── Compose files ────────────────────────────────────────────────────────────
COMPOSE_FILE=docker/docker-compose.yml:docker/development.yml:docker/supabase/docker-compose.yml:docker/supabase/supabase-development.yml

# ── Hosts ────────────────────────────────────────────────────────────────────
TELESCOPE_HOST=http://localhost:3000
API_HOST=localhost
WEB_URL=http://localhost:8000
API_VERSION=v1

# ── Service ports (required by docker-compose.yml) ───────────────────────────
POSTS_PORT=4444
SEARCH_PORT=4445
IMAGE_PORT=4446
FEED_DISCOVERY_PORT=4447
STATUS_PORT=4448
SSO_PORT=7777
PARSER_PORT=4449
DEPENDENCY_DISCOVERY_PORT=4450

# ── Service URLs ─────────────────────────────────────────────────────────────
POSTS_URL=http://localhost/v1/posts
SEARCH_URL=http://localhost/v1/search
IMAGE_URL=http://localhost/v1/image
AUTH_URL=http://localhost/v1/auth
STATUS_URL=http://localhost/v1/status
FEED_DISCOVERY_URL=http://localhost/v1/feed-discovery

# ── JWT / Auth (required by all services) ────────────────────────────────────
SECRET=telescope-super-secret-jwt-key-for-local-dev-only
JWT_SECRET=telescope-super-secret-jwt-key-for-local-dev-only
JWT_AUDIENCE=telescope.cdot.systems
JWT_ISSUER=telescope.cdot.systems

# ── SSO / SAML (local test IdP) ──────────────────────────────────────────────
SAML_ENTITY_ID=http://localhost/v1/auth
SSO_LOGIN_URL=http://localhost:8081/simplesaml/saml2/idp/SSOService.php
SSO_LOGIN_CALLBACK_URL=http://localhost/v1/auth/login/callback
SLO_LOGOUT_CALLBACK_URL=http://localhost/v1/auth/logout/callback
SSO_IDP_PUBLIC_KEY_
USERS_URL=http://localhost/v1/users
TELESCOPE_ADMINS=admin@example.com

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── Elasticsearch ─────────────────────────────────────────────────────────────
ELASTIC_URL=http://elasticsearch:9200
ELASTIC_MAX_RESULTS=100

